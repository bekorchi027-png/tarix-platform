{
  "headers": [
    {
      "source": "/tests.json",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/tests/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ],
  "functions": {
    "api/yordamchi.mjs": {
      "includeFiles": "{yordamchi-bilim.json,tests.json,xarita-davlatlar.js,joy-data.js,hukmdorlar.js}",
      "maxDuration": 40
    },
    "api/bot.mjs": {
      "includeFiles": "{tests.json,tests/*.json,sertifikat/qr.json,sertifikat/fonts/*.ttf}",
      "maxDuration": 30,
      "memory": 1024
    }
  }
}